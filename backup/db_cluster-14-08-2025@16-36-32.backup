--
-- Name: history_penjualan Allow insert for all; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow insert for all" ON public.history_penjualan FOR INSERT WITH CHECK (true);


--
-- Name: history_penjualan Allow read for all; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow read for all" ON public.history_penjualan FOR SELECT USING (true);


--
-- Name: operational_items Can insert item to own fund; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Can insert item to own fund" ON public.operational_items FOR INSERT WITH CHECK ((auth.uid() = ( SELECT operational_funds.user_id
   FROM public.operational_funds
  WHERE (operational_funds.id = operational_items.fund_id))));


--
-- Name: operational_items Can read own operational_items; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Can read own operational_items" ON public.operational_items FOR SELECT USING ((auth.uid() = ( SELECT operational_funds.user_id
   FROM public.operational_funds
  WHERE (operational_funds.id = operational_items.fund_id))));


--
-- Name: operational_items Can update own operational_items; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Can update own operational_items" ON public.operational_items FOR UPDATE USING ((auth.uid() = ( SELECT operational_funds.user_id
   FROM public.operational_funds
  WHERE (operational_funds.id = operational_items.fund_id)))) WITH CHECK ((auth.uid() = ( SELECT operational_funds.user_id
   FROM public.operational_funds
  WHERE (operational_funds.id = operational_items.fund_id))));


--
-- Name: stock_log Delete own stock logs; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Delete own stock logs" ON public.stock_log FOR DELETE USING ((user_id = auth.uid()));


--
-- Name: stock_log Insert own stock logs; Type: POLICY; Schema: public; Owner: postgres
